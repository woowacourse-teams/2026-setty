[Unit]
Description=SETTY Spring Boot backend
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=180
StartLimitBurst=10

[Service]
Type=simple
User=setty
Group=setty
WorkingDirectory=/opt/setty/app
EnvironmentFile=/opt/setty/setty.env
ExecStart=/usr/bin/java -jar /opt/setty/app/app.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
CapabilityBoundingSet=
AmbientCapabilities=
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
