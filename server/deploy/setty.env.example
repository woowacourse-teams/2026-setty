# EC2의 /opt/setty/setty.env를 직접 생성한 뒤 실제 값을 입력한다.
# systemd EnvironmentFile 형식이므로 export를 붙이지 않는다.
# 필수 값에 빈 따옴표("")나 공백만 입력하면 배포 사전 점검에서 실패한다.

SETTY_OPERATOR_SECRET=
SETTY_FRONT_BASE_URL=https://www.setty.cloud
SETTY_DISCORD_DISPATCH_WEBHOOK_URL=
SETTY_DISCORD_ESTIMATE_WEBHOOK_URL=

# 새 EC2에는 기존 로컬 MySQL이 없으므로 실제 DEV DB 접속 정보를 반드시 설정한다.
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
