# EC2의 /opt/setty/deploy.env에 복사한다. Bash 설정 파일이며 비밀 값은 넣지 않는다.
# 해당 EC2의 슬롯 프로필과 일치시킨다. prod에서는 prod와 prod URL로 바꾼다.
SETTY_DEPLOY_ENVIRONMENT=dev

SETTY_DEPLOY_ROOT=/opt/setty
SETTY_NGINX_UPSTREAM=/etc/nginx/setty/active-upstream.conf
SETTY_NGINX_ACCESS_LOG=/var/log/nginx/setty-access.log
SETTY_PROXY_HEALTH_URL=http://127.0.0.1/actuator/health
SETTY_SMOKE_URL=https://www.setty.cloud/dev/api/listings?size=1

# 관찰 시간은 운영 정책에 맞춰 조정한다. 아래 값은 기본값이다.
SETTY_HEALTH_TIMEOUT_SECONDS=180
SETTY_ROUTE_TIMEOUT_SECONDS=30
SETTY_OBSERVE_SECONDS=60
SETTY_DRAIN_TIMEOUT_SECONDS=180
SETTY_POLL_SECONDS=2
